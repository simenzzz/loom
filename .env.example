# ============================================================
# Loom — environment configuration
# Copy to .env and fill in. ALL runtime constants live here;
# hardcoded values in source are a review failure.
# ============================================================

# ---- Service ports (local dev) ----
LOOM_SERVER_PORT=7700          # Rust query server (axum)
LOOM_CRAWLER_PORT=7710         # Go crawler status API + WS dashboard feed
LOOM_ML_PORT=7720              # Python sidecar (FastAPI)
LOOM_WEB_PORT=5173             # Vite dev server
LOOM_FIXTURE_SITE_PORT=7799    # nginx fixture site (tests + local crawls)

# ---- Data locations ----
LOOM_DATA_DIR=./data           # root for crawl segments, index builds, sqlite
LOOM_CRAWL_DIR=./data/crawl
LOOM_INDEX_DIR=./data/index

# ---- Crawler ----
LOOM_CRAWLER_USER_AGENT="LoomBot/0.1 (+https://github.com/samibk/loom; polite vertical search crawler)"
LOOM_CRAWLER_GLOBAL_CONCURRENCY=8
LOOM_CRAWLER_DEFAULT_RPS_PER_HOST=1
LOOM_CRAWLER_MAX_BODY_BYTES=5242880

# ---- Query server ----
LOOM_SERVER_RESULT_CACHE_SIZE=1024
LOOM_SERVER_RATE_LIMIT_RPS=10

# ---- ML sidecar ----
LOOM_ML_SERVICE_TOKEN=change-me            # shared secret, engine -> sidecar
LOOM_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_OPS_ENABLED=false                      # query rewrite + summaries (P7)
LLM_PROVIDER=zai                           # zai | anthropic | gemini
LLM_API_KEY=
LLM_MODEL=glm-5.1

# ---- Web ----
VITE_LOOM_API_BASE=http://localhost:7700
VITE_LOOM_CRAWLER_WS=ws://localhost:7710/ws
