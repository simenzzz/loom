# Pinned codegen toolchain — the single source for generate.sh, Makefile
# setup, and CI. Bumping a version here regenerates different output, so a
# bump must land in the same commit as the regenerated code.
CARGO_TYPIFY_VERSION=0.7.0
GO_JSONSCHEMA_MODULE=github.com/atombender/go-jsonschema
GO_JSONSCHEMA_VERSION=v0.23.1
DATAMODEL_CODEGEN_VERSION=0.68.1
# json-schema-to-typescript is pinned in package.json / package-lock.json
